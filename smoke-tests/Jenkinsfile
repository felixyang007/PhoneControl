// Smoke-test pipeline. Runs on a Mac agent that has phone-control (control API
// on :9090), adb, scrcpy, maestro, jq. See docs/jenkins-setup.md for agent setup.
//
// The Mac agent MUST run as a LaunchAgent under an auto-login GUI user (not a
// LaunchDaemon) so it has the Aqua/TCC context for screen recording + USB/ADB.

pipeline {
  // Pin to the Mac device-lab node (set this label on the agent in Jenkins).
  agent { label 'mac-device-lab' }

  parameters {
    string(name: 'FLOW', defaultValue: 'smoke-tests/plaud-smoke.yaml',
           description: 'Maestro flow to run (settings-smoke.yaml is the no-creds demo)')
    string(name: 'APK_PATH', defaultValue: '',
           description: 'APK to install first (empty = test whatever is installed). A path on the agent, or use a Copy-Artifact step upstream.')
    string(name: 'DEVICE_SERIAL', defaultValue: '',
           description: 'Specific device serial, or empty to lease any idle device')
    booleanParam(name: 'FILE_LINEAR', defaultValue: false,
           description: 'On failure, file a Linear bug (needs Linear MCP configured on the agent)')
  }

  options {
    // On abort/timeout Jenkins sends SIGTERM to the process group — smoke-run.sh's
    // trap then still runs capture/stop + report + release. 15m is the hard cap.
    timeout(time: 15, unit: 'MINUTES')
    disableConcurrentBuilds()   // one smoke run per node at a time
  }

  environment {
    // Homebrew + Maestro on PATH for a non-login Jenkins shell.
    PATH      = "/opt/homebrew/bin:${HOME}/.maestro/bin:${env.PATH}"
    TASK      = "${env.JOB_NAME}-${env.BUILD_NUMBER}"
    ARTIFACTS = "${env.WORKSPACE}/artifacts"
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Preflight') {
      steps {
        sh '''
          set -e
          mkdir -p "$ARTIFACTS"
          adb version | head -1
          maestro -v | head -1
          # phone-control must already be running (LaunchAgent). Fail fast if not.
          curl -sf http://127.0.0.1:9090/api/v1/health \
            || { echo "phone-control control API not up on :9090"; exit 1; }
        '''
      }
    }

    stage('Smoke') {
      // Login creds come from a Jenkins username/password credential (id
      // 'plaud-qa-login') and are injected into the flow via Maestro --env,
      // so no secret lives in git. Clean-install uninstalls the app first.
      steps {
        withCredentials([usernamePassword(credentialsId: 'plaud-qa-login',
                          usernameVariable: 'LOGIN_USER', passwordVariable: 'LOGIN_PASS')]) {
          sh '''
            set -e
            serialArg="";  [ -n "$DEVICE_SERIAL" ] && serialArg="--serial $DEVICE_SERIAL"
            apkArg="";      [ -n "$APK_PATH" ]     && apkArg="--apk $APK_PATH --uninstall ai.plaud.android.plaud"
            triageArg="--triage"; [ "$FILE_LINEAR" = "true" ] && triageArg="--triage-create"
            envArgs=""
            [ -n "$LOGIN_USER" ] && envArgs="--maestro-env LOGIN_USER=$LOGIN_USER --maestro-env LOGIN_PASS=$LOGIN_PASS"

            # Token is read from ~/.phone_control/api_token by smoke-run.sh.
            smoke-tests/smoke-run.sh \
              --flow "$FLOW" $serialArg $apkArg $envArgs \
              --task "$TASK" \
              --output-dir "$ARTIFACTS" \
              --junit "$ARTIFACTS/junit.xml" \
              $triageArg
          '''
        }
      }
    }
  }

  post {
    always {
      // mp4 + logcat + manifest + junit — archived even on failure (trap wrote them).
      archiveArtifacts artifacts: 'artifacts/**', allowEmptyArchive: true, fingerprint: true
      junit testResults: 'artifacts/junit.xml', allowEmptyResults: true
    }
    failure {
      echo "Smoke failed — see artifacts/${TASK}-manifest.json for the AI triage + logcat/mp4."
    }
  }
}
